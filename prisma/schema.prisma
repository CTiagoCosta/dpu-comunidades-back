// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== ROLE =====
model Role {
  id    Int    @id @default(autoincrement())
  name  String

  users User[]

  @@map("role")
}

// ===== USUÁRIOS =====
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  nome         String
  senha        String
  roleId       Int
  aprovado     Boolean  @default(false)
  dataCadastro DateTime @default(now())

  // Relacionamentos
  role                     Role                   @relation(fields: [roleId], references: [id])
  triagensOperador         Triagem[]              @relation("OperadorTriagem")
  atendimentosOperador     Atendimento[]          @relation("OperadorAtendimento")
  documentosUpload         Documento[]            @relation("OperadorUpload")
  logsTriagem              LogTriagem[]

  @@map("usuarios")
}

// ===== ASSISTIDO =====
model Assistido {
  id           String  @id @default(uuid()) @db.Uuid
  nomeCompleto String
  nomeSocial   String?
  cpf          String
  telefone     String?
  migrante     Boolean @default(false)

  // Relacionamentos
  triagens         Triagem[]
  membrosFamilia   MembroFamiliar[]

  @@map("assistido")
}

// ===== TRIAGEM =====
model Triagem {
  id                String   @id @default(uuid()) @db.Uuid
  isPrioridade      Boolean  @default(false)
  status            String
  dataEntrada       DateTime @default(now())
  operadorTriagemId String   @db.Uuid
  tipoPrioridadeId  Int?
  tipoAtendimentoId Int
  assistidoId       String   @db.Uuid

  // Relacionamentos
  operadorTriagem   User              @relation("OperadorTriagem", fields: [operadorTriagemId], references: [id])
  tipoPrioridade    TipoPrioridade?   @relation(fields: [tipoPrioridadeId], references: [id])
  tipoAtendimento   TipoAtendimento   @relation(fields: [tipoAtendimentoId], references: [id])
  assistido         Assistido         @relation(fields: [assistidoId], references: [id])
  atendimento       Atendimento?
  logsTriagem       LogTriagem[]

  @@map("triagem")
}

// ===== PRIMEIRO ATENDIMENTO =====
model Atendimento {
  id                              String    @id @default(uuid()) @db.Uuid
  capacidadeCivil                 Boolean?
  cep                             String?
  endereco                        String?
  numero                          Int?
  complemento                     String?
  bairro                          String?
  cidade                          String?
  uf                              String?
  dataInicioBeneficio             DateTime?
  parcelasVencidas                Int?
  valorCausa                      Float?
  processosAndamento              String?
  estadoCivilId                   Int?
  profissaoId                     String?   @db.Uuid
  tipoDomicilioId                 Int?
  tipoDemandaPrevidenciariaId     Int?
  competenciaJudicialId           Int?
  descricaoPrioridade             String?
  tipoAtendimentoId               Int?
  tipoServicoAtendimentoId        Int?
  tipoPrioridadeId                Int?
  triagemId                       String    @unique @db.Uuid
  operadorAtendimentoId           String    @db.Uuid

  // Relacionamentos
  estadoCivil                     EstadoCivil?                    @relation(fields: [estadoCivilId], references: [id])
  profissao                       Profissao?                      @relation(fields: [profissaoId], references: [id])
  tipoDomicilio                   TipoDomicilio?                  @relation(fields: [tipoDomicilioId], references: [id])
  tipoDemandaPrevidenciaria       TipoDemandaPrevidenciaria?      @relation(fields: [tipoDemandaPrevidenciariaId], references: [id])
  competenciaJudicial             CompetenciaJudicial?            @relation(fields: [competenciaJudicialId], references: [id])
  tipoAtendimento                 TipoAtendimento?                @relation(fields: [tipoAtendimentoId], references: [id])
  tipoServicoAtendimento          TipoServicoAtendimento?         @relation(fields: [tipoServicoAtendimentoId], references: [id])
  tipoPrioridade                  TipoPrioridade?                 @relation(fields: [tipoPrioridadeId], references: [id])
  triagem                         Triagem                         @relation(fields: [triagemId], references: [id])
  operadorAtendimento             User                            @relation("OperadorAtendimento", fields: [operadorAtendimentoId], references: [id])
  processo                        Processo?
  formulariosPreenchidos          FormularioPreenchido[]
  documentos                      Documento[]
  membrosFamilia                  MembroFamiliar[]

  @@map("atendimentos")
}

// ===== PROCESSOS JUDICIAIS =====
model Processo {
  id                 String    @id @default(uuid()) @db.Uuid
  numeroProcesso     String?
  resultado          String?
  resultadoDetalhado String?
  valoresAtrasados   String?
  beneficios         String?
  dataAtualizacao    DateTime  @default(now())
  atendimentoId      String    @unique @db.Uuid

  // Relacionamentos
  atendimento        Atendimento @relation(fields: [atendimentoId], references: [id])

  @@map("processos")
}

// ===== FORMULÁRIOS PREENCHIDOS =====
model FormularioPreenchido {
  id              Int      @id @default(autoincrement())
  tipoFormulario  String
  dadosFormulario Json
  dataCriacao     DateTime @default(now())
  atendimentoId   String   @db.Uuid

  // Relacionamentos
  atendimento     Atendimento @relation(fields: [atendimentoId], references: [id])

  @@map("formularios_preenchidos")
}

// ===== DOCUMENTOS =====
model Documento {
  id                String   @id @default(uuid()) @db.Uuid
  nomeOriginal      String
  nomeArmazenamento String
  tipo              String
  tamanho           Int
  caminho           String
  tipoDocumento     String
  dataCriacao       DateTime @default(now())
  atendimentoId     String   @db.Uuid
  operadorUploadId  String   @db.Uuid

  // Relacionamentos
  atendimento       Atendimento @relation(fields: [atendimentoId], references: [id])
  operadorUpload    User        @relation("OperadorUpload", fields: [operadorUploadId], references: [id])

  @@map("documentos")
}

// ===== TABELAS AUXILIARES =====
model TipoAtendimento {
  id        Int    @id @default(autoincrement())
  descricao String

  // Relacionamentos
  triagens                Triagem[]
  atendimentos            Atendimento[]
  tiposServicoAtendimento TipoServicoAtendimento[]

  @@map("tipo_atendimento")
}

model TipoPrioridade {
  id              Int @id @default(autoincrement())
  descricao       String
  valorPrioridade Int

  // Relacionamentos
  triagens        Triagem[]
  atendimentos    Atendimento[]

  @@map("tipo_prioridade")
}

model TipoServicoAtendimento {
  id                Int    @id @default(autoincrement())
  descricao         String
  tipoAtendimentoId Int

  // Relacionamentos
  tipoAtendimento   TipoAtendimento @relation(fields: [tipoAtendimentoId], references: [id])
  atendimentos      Atendimento[]

  @@map("tipo_servico_atendimento")
}

model EstadoCivil {
  id        Int    @id @default(autoincrement())
  descricao String

  // Relacionamentos
  atendimentos Atendimento[]

  @@map("estado_civil")
}

model Profissao {
  id        String @id @default(uuid()) @db.Uuid
  descricao String

  // Relacionamentos
  atendimentos Atendimento[]

  @@map("profissao")
}

model TipoDomicilio {
  id        Int    @id @default(autoincrement())
  descricao String

  // Relacionamentos
  atendimentos Atendimento[]

  @@map("tipo_domicilio")
}

model MembroFamiliar {
  id            String  @id @default(uuid()) @db.Uuid
  nomeCompleto  String
  cpf           String
  rendaMensal   Float?
  atendimentoId String  @db.Uuid
  assistidoId   String  @db.Uuid

  // Relacionamentos
  atendimento   Atendimento @relation(fields: [atendimentoId], references: [id])
  assistido     Assistido   @relation(fields: [assistidoId], references: [id])

  @@map("membro_familiar")
}

model TipoVulnerabilidade {
  id        Int    @id @default(autoincrement())
  descricao String

  @@map("tipo_vulnerabilidade")
}

model TipoDemandaPrevidenciaria {
  id        Int    @id @default(autoincrement())
  descricao String

  // Relacionamentos
  atendimentos Atendimento[]

  @@map("tipo_demanda_previdenciaria")
}

model CompetenciaJudicial {
  id        Int    @id @default(autoincrement())
  descricao String

  // Relacionamentos
  atendimentos Atendimento[]

  @@map("competencia_judicial")
}

// ===== LOG TRIAGEM =====
model LogTriagem {
  id        String   @id @default(uuid()) @db.Uuid
  action    String
  queueId   String   @db.Uuid
  userId    String   @db.Uuid
  timestamp DateTime @default(now())
  details   String?

  // Relacionamentos
  queue     Triagem @relation(fields: [queueId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@map("log_triagem")
}

model EncaminhamentoServico {
  id                Int    @id @default(autoincrement())
  categoria         String
  nomeServico       String
  endereco          String
  descricaoViolacao String

  @@map("encaminhamento_servico")
}
